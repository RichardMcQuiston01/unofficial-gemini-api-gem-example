# Dependencies and build output are (re)generated inside the image.
**/node_modules/
**/dist/

# VCS and CI
.git
.github

# Secrets — never send these into the build context.
*.env
*.env.*
!.env.example
google_service_account.json

# Local editor / OS cruft
.idea
.vscode
.DS_Store
Thumbs.db
*.log

# Example output
examples/generated-icon.*
